# ====================================================================
# ResolveAI Environment Variables Configuration
# ====================================================================

# Port for ResolveAI backend & frontend
PORT=3000
NODE_ENV=development

# Application Base URL
APP_URL="http://localhost:3000"

# Gemini AI API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resolveai"
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=resolveai

# Authentication Secret
JWT_SECRET="resolveai_jwt_super_secret_key_change_in_production"

# Gmail Integration (Modular OAuth Configuration)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/gmail/oauth/callback"

# WhatsApp Business API (Meta Cloud API / Webhook)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="resolveai_whatsapp_webhook_secret_verify_token"
